# Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# Comma-separated admin Telegram IDs
ADMIN_IDS=123456789

# SQLite database path
DB_PATH=vox_nft.db

# NFT receiver username (without @)
NFT_RECEIVER_USERNAME=hawkuy

# Evaluation percentage (how much of floor price to offer)
EVALUATION_PERCENT=85

# Transfer check interval (seconds)
CHECK_INTERVAL_SECONDS=10

# Transfer check timeout (seconds)
CHECK_TIMEOUT_SECONDS=600
