<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⊕ STANDCHILLOW AIMBOT"
            android:textColor="#FF00FF00"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Только для офлайн режима против ботов"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingBottom="16dp" />

        <!-- Permissions Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="РАЗРЕШЕНИЯ"
            android:textColor="#FF4CAF50"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Оверлей поверх окон:"
                android:textColor="#CCCCCC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvOverlayStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✗ Не разрешено"
                android:textColor="#FFFF0000"
                android:textSize="12sp"
                android:paddingEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGrantOverlay"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Дать"
                android:textSize="11sp"
                app:cornerRadius="4dp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Специальные возможности:"
                android:textColor="#CCCCCC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvAccessibilityStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✗ Не включено"
                android:textColor="#FFFF0000"
                android:textSize="12sp"
                android:paddingEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGrantAccessibility"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Дать"
                android:textSize="11sp"
                app:cornerRadius="4dp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="12dp" />

        <!-- Target Color Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ЦВЕТ ЦЕЛИ"
            android:textColor="#FF4CAF50"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnColorRed"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Красный"
                android:textSize="10sp"
                app:backgroundTint="#FFD32F2F"
                app:cornerRadius="4dp"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnColorGreen"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Зелёный"
                android:textSize="10sp"
                app:backgroundTint="#FF388E3C"
                app:cornerRadius="4dp"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnColorYellow"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Жёлтый"
                android:textSize="10sp"
                app:backgroundTint="#FFF9A825"
                app:cornerRadius="4dp"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnColorCustom"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Свой"
                android:textSize="10sp"
                app:backgroundTint="#FF616161"
                app:cornerRadius="4dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="12dp" />

        <!-- Sensitivity -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="НАСТРОЙКИ"
            android:textColor="#FF4CAF50"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Чувствительность:"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvSensitivityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.0"
                android:textColor="#FF00FF00"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderSensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.1"
            android:valueTo="5.0"
            android:stepSize="0.1"
            android:value="1.0"
            app:thumbColor="#FF4CAF50"
            app:trackColorActive="#FF4CAF50"
            app:trackColorInactive="#FF333333" />

        <!-- FOV -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Радиус FOV:"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvFovValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="150px"
                android:textColor="#FF00FF00"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderFov"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="50"
            android:valueTo="500"
            android:stepSize="10"
            android:value="150"
            app:thumbColor="#FF4CAF50"
            app:trackColorActive="#FF4CAF50"
            app:trackColorInactive="#FF333333" />

        <!-- Smooth Aim -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Плавное наведение:"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchSmoothing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:thumbTint="#FF4CAF50"
                app:trackTint="#FF333333" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Коэффициент плавности:"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvSmoothValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.30"
                android:textColor="#FF00FF00"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderSmoothFactor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.05"
            android:valueTo="1.0"
            android:stepSize="0.05"
            android:value="0.30"
            app:thumbColor="#FF4CAF50"
            app:trackColorActive="#FF4CAF50"
            app:trackColorInactive="#FF333333" />

        <!-- Headshot mode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Режим хедшот:"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchHeadshot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="#FF4CAF50"
                app:trackTint="#FF333333" />
        </LinearLayout>

        <!-- Triggerbot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Триггер бот:"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchTriggerbot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="#FF4CAF50"
                app:trackTint="#FF333333" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="16dp" />

        <!-- Control Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="ЗАПУСТИТЬ"
                android:textSize="14sp"
                app:backgroundTint="#FF2E7D32"
                app:cornerRadius="8dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="ОСТАНОВИТЬ"
                android:textSize="14sp"
                app:backgroundTint="#FFB71C1C"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="v1.0 | Только для офлайн Standchillow"
            android:textColor="#44FFFFFF"
            android:textSize="10sp"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

    </LinearLayout>
</ScrollView>
