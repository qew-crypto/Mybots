# Telegram API (получить на https://my.telegram.org/apps)
API_ID=12345678
API_HASH=your_api_hash_here

# Телефон аккаунта (с кодом страны)
PHONE=+79991234567

# Пароль от аккаунта (двухфакторная аутентификация, если включена)
PASSWORD=

# OpenAI API ключ (получить на https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here

# Модель GPT (по умолчанию gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Список разрешённых user_id через запятую (пусто = отвечать всем)
ALLOWED_USERS=
