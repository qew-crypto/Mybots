# Скопируй этот файл в .env и заполни значения.
# Токен НЕ хранится в архиве специально.
BOT_TOKEN=your_bot_token_here

# Telegram ID админов через запятую.
ADMIN_IDS=7962973666

# Файл SQLite базы данных.
DB_PATH=bot.db

# Контакт, который увидит пользователь в разделе поддержки.
SUPPORT_CONTACT=@your_support_username
