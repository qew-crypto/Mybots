# Telegram API (получить на https://my.telegram.org/apps)
API_ID=12345678
API_HASH=your_api_hash_here

# Телефон аккаунта (с кодом страны)
PHONE=+79991234567

# Пароль от аккаунта (двухфакторная аутентификация, если включена)
PASSWORD=

# Список разрешённых user_id через запятую (пусто = отвечать всем)
ALLOWED_USERS=

# OpenAI-совместимый API
API_BASE_URL=https://api.freetheai.xyz/v1
API_KEY=your_api_key_here

# Модель GPT (по умолчанию gpt-4o)
GPT_MODEL=gpt-4o
